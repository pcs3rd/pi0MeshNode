# Direct firmware boot (no U-Boot): the Pi firmware loads kernel/initrd/DTBs from
# slot_a/ or slot_b/ on the FIRMWARE partition via os_prefix. This is what makes the
# firmware "tryboot" A/B mechanism work identically on Pi Zero, Zero 2 W, 3 and 4.
{ config, lib, pkgs, ... }:
let
  cfg = config.meshnode.rpi;
  kernel = config.boot.kernelPackages.kernel;
  fw = "${pkgs.raspberrypifw}/share/raspberrypi/boot";
  bp = pkgs.buildPackages;

  commonTxt = pkgs.writeText "common.txt" ''
    # Shared by both slots - generated by modules/rpi-boot.nix
    [all]
    kernel=kernel.img
    initramfs initrd followkernel
    ${lib.optionalString cfg.arm64 "arm_64bit=1"}
    enable_uart=1
    disable_splash=1
    gpu_mem=16
    dtparam=spi=on
    dtparam=i2c_arm=on
    ${lib.optionalString (!cfg.hdmi) ''
      # Headless: keep the HDMI PHY off (~25 mA on a Zero). The image never loads the vc4 KMS
      # driver, so the firmware's legacy display options still apply.
      hdmi_blanking=2
      hdmi_force_hotplug=0
      hdmi_ignore_hotplug=1
    ''}
    ${cfg.extraConfig}
  '';

  slotCfg = slot: pkgs.writeText "config-${slot}.txt" ''
    # managed by meshnode-ota - do not edit by hand
    [all]
    os_prefix=slot_${slot}/
    include common.txt
  '';
in
{
  options.meshnode.rpi = {
    arm64 = lib.mkOption {
      type = lib.types.bool;
      description = "Boot the kernel in 64-bit mode (arm_64bit=1).";
    };
    usbWifi.ath9kHtc = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Ship ath9k_htc firmware for Atheros AR9271/AR7010 USB Wi-Fi adapters (e.g. Netgear WNA1100). ~100 KB.";
    };
    hdmi = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        HDMI output plus a console and login on it. Off by default (headless nodes save ~25 mA):
        the firmware keeps HDMI powered down and there are no virtual terminals. With HDMI off
        and the serial console off (a GPS on the UART), the only way in is the network
        (SSH / Tailscale SSH).
      '';
    };
    serialConsole = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Kernel console + login on the header UART (GPIO14/15, pins 8/10). Turned off by default
        when a serial GPS is enabled (meshnode.meshtastic.gps), since they share those pins.
      '';
    };
    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Extra config.txt lines (via common.txt) applied to both slots.";
    };
  };

  config = {
    boot.loader.grub.enable = false;
    boot.loader.generic-extlinux-compatible.enable = false;
    hardware.deviceTree.enable = false; # the firmware loads DTBs + overlays itself

    # systemd runs as PID 1 *and* in stage 1. nixpkgs has removed the scripted initrd, so
    # the systemd initrd is the only one and needs no option.

    # Vendor kernels lack many of NixOS' default initrd modules; keep the list tiny
    # and let the closure builder skip anything that is built in or absent.
    boot.initrd.includeDefaultModules = false;
    boot.initrd.availableKernelModules = lib.mkForce [
      "mmc_block" "usb_storage" "usbhid"
      "erofs" "overlay" "loop" # EROFS /nix/store slot + system.etc.overlay
      "ext4" "vfat" "nls_cp437" "nls_iso8859_1"
    ];
    # LZ4 is much cheaper to unpack than the zstd default on ARMv6. -l = legacy frame format
    # (what the kernel unpacks); -12 = HC level: smaller initrd, same decompressor speed.
    boot.initrd.compressor = "lz4";
    boot.initrd.compressorArgs = [ "-l" "-12" ];

    # The kernel itself (vendor build + config trim) is in modules/kernel.nix.
    nixpkgs.overlays = [
      (final: prev: { makeModulesClosure = x: prev.makeModulesClosure (x // { allowMissing = true; }); })
    ];

    # Always name a console. With no console= at all the kernel falls back to the firmware's
    # stdout-path - the header UART - and systemd then runs a serial getty on the GPS pins.
    # tty1 exists even with HDMI off and no gettys (console.enable = false), so it's a sink.
    # The last console= becomes /dev/console.
    boot.kernelParams = lib.optional cfg.serialConsole "console=serial0,115200" ++ [ "console=tty1" ];

    # /dev/serial0 and /dev/serial1 as on Raspberry Pi OS: serial0 is whichever UART the
    # firmware routed to GPIO14/15 (pins 8/10) - the full PL011 (ttyAMA*) with
    # dtoverlay=disable-bt or on boards without Bluetooth, else the mini UART (ttyS0).
    # Matches the tty's device-tree node against /proc/device-tree/aliases/serialN.
    services.udev.extraRules =
      let
        alias = pkgs.writeShellScript "rpi-serial-alias" ''
          node=$(${pkgs.coreutils}/bin/readlink -f "/sys/class/tty/$1/device/of_node") || exit 1
          node=''${node#/sys/firmware/devicetree/base}
          for i in 0 1; do
            a=/proc/device-tree/aliases/serial$i
            if [ -e "$a" ] && [ "$(${pkgs.coreutils}/bin/tr -d '\000' < "$a")" = "$node" ]; then
              echo "$i"; exit 0
            fi
          done
          exit 1
        '';
      in
      ''
        KERNEL=="ttyAMA[0-9]*|ttyS[0-9]*", PROGRAM="${alias} %k", SYMLINK+="serial%c", GROUP="dialout", MODE="0660"
      '';
    console.enable = cfg.hdmi; # no virtual terminals / gettys on a headless node

    nixpkgs.config.allowUnfreePredicate = pkg:
      builtins.elem (lib.getName pkg) [ "raspberrypi-firmware" "raspberrypi-wireless-firmware" "linux-firmware" ];
    hardware.firmware = [
      pkgs.raspberrypiWirelessFirmware # onboard brcmfmac (Zero W, Zero 2 W, 3, 4)
    ] ++ lib.optional cfg.usbWifi.ath9kHtc (
      # Atheros AR9271 / AR7010 USB adapters (Netgear WNA1100, TP-Link TL-WN722N v1, Alfa
      # AWUS036NHA...): driver ath9k_htc is =m in every vendor defconfig; it only needs these
      # files. Copy just them so the image doesn't carry all of linux-firmware.
      pkgs.runCommand "ath9k-htc-firmware" { } ''
        mkdir -p $out/lib/firmware
        cp -r ${pkgs.linux-firmware}/lib/firmware/ath9k_htc $out/lib/firmware/
        for f in htc_9271.fw htc_7010.fw; do
          if [ -e ${pkgs.linux-firmware}/lib/firmware/$f ]; then
            cp -L ${pkgs.linux-firmware}/lib/firmware/$f $out/lib/firmware/
          fi
        done
      ''
    );

    # Contents of one slot_X/ directory. cmdline.base gets " abslot=X" appended when installed.
    system.build.rpiSlot = bp.runCommand "meshnode-rpi-slot" { } ''
      mkdir -p $out/overlays
      cp ${kernel}/${config.system.boot.loader.kernelFile} $out/kernel.img
      cp ${config.system.build.initialRamdisk}/${config.system.boot.loader.initrdFile} $out/initrd
      find ${kernel}/dtbs -name '*.dtb' -exec cp {} $out/ \;
      if [ -d ${kernel}/dtbs/overlays ]; then
        cp ${kernel}/dtbs/overlays/* $out/overlays/
      else
        cp ${fw}/overlays/* $out/overlays/
      fi
      chmod -R u+w $out
      echo "init=${config.system.build.toplevel}/init ${toString config.boot.kernelParams}" > $out/cmdline.base
    '';

    # Shared top level of the FIRMWARE partition. Note: these blobs are NOT A/B - OTA
    # bundles only replace slot_X/. Firmware updates need a reflash (or a careful manual copy).
    system.build.rpiFirmwareDir = bp.runCommand "meshnode-rpi-firmware" { } ''
      mkdir -p $out
      cp ${fw}/bootcode.bin ${fw}/start*.elf ${fw}/fixup*.dat $out/
      cp ${commonTxt} $out/common.txt
      cp ${slotCfg "a"} $out/config.txt
      cp ${slotCfg "a"} $out/tryboot.txt
      chmod -R u+w $out
    '';
  };
}
